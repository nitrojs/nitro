{
  "compilerOptions": {
    "paths": {
      "~app/*": ["../app/*"],
      "@greeting": ["../app/greeting.ts"],
      // Next targets are tried when one does not resolve
      "@fallback": ["../app/missing.ts", "../app/fallback.ts"],
      // The `alias` option takes precedence
      "@aliased": ["../app/greeting.ts"],
      // Packages resolve to their `paths` target, like with TypeScript
      "defu": ["../app/defu.ts"],
      // The Vite `resolve.alias` option takes precedence (Vite builder)
      "@vite-aliased": ["../app/greeting.ts"],
      // Type-only targets (e.g. generated by frameworks) keep the regular resolution
      "nitro/h3": ["../types/h3.d.mts"],
      "xml2js": ["../types/xml2js.d.ts"],
      "etag": ["../../../../node_modules/@types/etag"]
    }
  }
}
